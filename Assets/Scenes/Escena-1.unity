--- !u!1001 &1349749366
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 64149746943331825, guid: 790a89c5819c844aea0c8530d49b8b7e, type: 3}
      propertyPath: speakerName
      value: Portero Roberto
      objectReference: {fileID: 0}
    - target: {fileID: 64149746943331825, guid: 790a89c5819c844aea0c8530d49b8b7e, type: 3}
      propertyPath: dialogueText
      value: Quere proba estas pastis?...
      objectReference: {fileID: 0}
    - target: {fileID: 64149746943331825, guid: 790a89c5819c844aea0c8530d49b8b7e, type: 3}
      propertyPath: 'dialogueChoices.Array.data[0]'
      value: "\xBFQu\xE9 hay de nuevo Roberto?"
      objectReference: {fileID: 0}
    - target: {fileID: 64149746943331825, guid: 790a89c5819c844aea0c8530d49b8b7e, type: 3}
      propertyPath: 'dialogueChoices.Array.data[1]'
      value: "\xBFPuedo preguntar cuanto cobras?"
      objectReference: {fileID: 0}
    - target: {fileID: 64149746943331825, guid: 790a89c5819c844aea0c8530d49b8b7e, type: 3}
      propertyPath: 'dialogueChoices.Array.data[2]'
      value: '*Aceptar las pastillas*'
      objectReference: {fileID: 0}
    - target: {fileID: 64149746943331825, guid: 790a89c5819c844aea0c8530d49b8b7e, type: 3}
      propertyPath: 'happinessDeltas.Array.data[0]'
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 64149746943331825, guid: 790a89c5819c844aea0c8530d49b8b7e, type: 3}
      propertyPath: 'happinessDeltas.Array.data[1]'
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 64149746943331825, guid: 790a89c5819c844aea0c8530d49b8b7e, type: 3}
      propertyPath: 'happinessDeltas.Array.data[2]'
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 64149746943331825, guid: 790a89c5819c844aea0c8530d49b8b7e, type: 3}
      propertyPath: 'psychedeliaDeltas.Array.data[0]'
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 64149746943331825, guid: 790a89c5819c844aea0c8530d49b8b7e, type: 3}
      propertyPath: 'psychedeliaDeltas.Array.data[2]'
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 64149746943331825, guid: 790a89c5819c844aea0c8530d49b8b7e, type: 3}
      propertyPath: 'responseAfterChoice.Array.data[0]'
      value: "Desde que levantaron las antenas de 5G me afloraron las hemorroides,
        pero la obra social no me cree. Ahora me estoy peleando con el gremio para 
        que apaguen el wifi, el partido comunista chino esp\xEDa nuestros pensamientos "
      objectReference: {fileID: 0}
    - target: {fileID: 64149746943331825, guid: 790a89c5819c844aea0c8530d49b8b7e, type: 3}
      propertyPath: 'responseAfterChoice.Array.data[1]'
      value: "Aca cobro la minima, pero me financi\xF3 vendiendo y comprando lencer\xEDa
        en internet"
      objectReference: {fileID: 0}
    - target: {fileID: 64149746943331825, guid: 790a89c5819c844aea0c8530d49b8b7e, type: 3}
      propertyPath: 'responseAfterChoice.Array.data[2]'
      value: "veo que decidiste el camino de la verdad. Ten\xE9 cuidado, el voltaje
        nos muestra las cosas tal como son, pero eso es demasiado para las mentes
        d\xE9biles. "
      objectReference: {fileID: 0}
